const User = require('../models/User');
const cloudinary = require('cloudinary').v2; // Use Cloudinary for image upload

const updateProfile = async (req, res) => {
  try {
    const { bio } = req.body;
    let profilePicUrl = '';

    if (req.files && req.files.profilePic) {
      const result = await cloudinary.uploader.upload(req.files.profilePic.tempFilePath);
      profilePicUrl = result.secure_url;
    }

    const updatedUser = await User.findByIdAndUpdate(req.userId, { bio, profilePic: profilePicUrl }, { new: true });
    res.status(200).json(updatedUser);
  } catch (error) {
    res.status(500).json({ message: 'Failed to update profile' });
  }
};
